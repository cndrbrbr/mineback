# agent.env — mineback-agent configuration. Copy to /etc/mineback/agent.env
# on each MHS hosting host. Shell-sourced KEY=value; no quoting needed for
# plain values. See ARCHITECTURE.md §3-4 for what each of these drives.

# Unique, stable id for this host — survives a rebuild as long as you reuse
# it. Becomes the top-level directory under the vault's store/ and public/.
MINEBACK_HOST_ID=kag-workshop-01

# Where to push snapshots. "local" talks to mineback-receive directly on
# this same machine (only for testing / a colocated vault); otherwise an
# ssh:// URL to the vault, reached over the agent's own restricted key.
MINEBACK_VAULT=ssh://mc-backup@vault.example:22
MINEBACK_VAULT_SSH_KEY=/etc/mineback/agent_key

# Public age recipient(s) the vault gave you (see `mineback host add`) — the
# agent can encrypt secrets.age with this but never decrypt anything with it.
MINEBACK_RECIPIENTS_FILE=/etc/mineback/recipients.age

# The student servers on this host, and the lobby/proxy for --fleet runs.
# Names must match the actual container name docker ps shows — that's not
# always the compose file's service name: minecraftHostingServer sets
# `container_name:` explicitly, but not every stack does, and Compose then
# auto-names it <project-dir>-<service>-<N> instead.
#
# Set MINEBACK_LOBBY / MINEBACK_PROXY to the literal string "none" (not
# blank — an empty value still falls back to the default below) for a host
# that structurally has no lobby/proxy at all, e.g. a single standalone
# server. Leaving them at a name that's simply never running is different:
# --fleet marks itself "partial" and exits non-zero every run, forever,
# which is the right signal for a role that's *supposed* to exist and
# isn't up, but noise for one that was never there.
MINEBACK_SERVERS="mc1 mc2 mc3 mc4 mc5"
MINEBACK_LOBBY=lobby
MINEBACK_PROXY=bungee

# Path to the MHS checkout on this host, for fleet-level hostconf capture
# (compose files, local spigot/+bungee/ edits, .env, keys/). Leave unset to
# skip hostconf capture — a fleet run still snapshots every server, marked
# "partial" and non-zero-exit so the gap is visible rather than silent.
MINEBACK_MHS_DIR=/root/hostMC/minecraftHostingServer

# How long to wait for the in-game "Saved the game" confirmation during a
# hot quiesce, and for the java process to exit during a cold one.
MINEBACK_FLUSH_TIMEOUT=60
MINEBACK_STOP_TIMEOUT=30

# Optional: spool artifacts to a temp file before sending instead of
# streaming directly, for links too flaky to hold one long connection.
# MINEBACK_SPOOL_DIR=/var/tmp/mineback-spool

MINEBACK_LOG=/var/log/mineback-agent.log
