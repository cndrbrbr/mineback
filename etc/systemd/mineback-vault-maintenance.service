[Unit]
Description=mineback vault maintenance — scrub, gc, prune (auto-delete)

[Service]
Type=oneshot
# Auto-prune is opted into deliberately: keep_last=1 in mineback.toml means
# only the newest snapshot per server is meant to survive, so this unit
# actually deletes what GFS retention marks prunable every week.
ExecStart=/usr/local/bin/mineback vault verify --gc
ExecStart=/usr/local/bin/mineback vault prune --yes
